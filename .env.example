NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB v3 API key (themoviedb.org/settings/api). Server-only, no NEXT_PUBLIC_ prefix.
TMDB_API_KEY=

# Google Books API key (console.cloud.google.com, enable "Books API").
# Optional but recommended: without it, requests share Google's low
# unauthenticated daily quota. Server-only, no NEXT_PUBLIC_ prefix.
GOOGLE_BOOKS_API_KEY=

# Set to "true" to serve fixture search results from src/lib/catalog/mock-data.ts
# instead of calling Google Books/TMDB. Speeds up local dev and avoids quotas.
# Leave unset (or any other value) to use the real APIs.
MOCK_EXTERNAL_APIS=

# Seeded dev/test account (onboarding already completed) so manual and agent
# QA can log in directly instead of running signup + onboarding every time.
# Not used by the app itself — only referenced in docs/TESTING.md and by the
# qa-verifier agent. Create the account once via /signup and keep it around
# for the life of the project; never delete it as part of test cleanup.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_USERNAME=
