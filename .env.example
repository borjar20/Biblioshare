NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB v3 API key (themoviedb.org/settings/api). Server-only, no NEXT_PUBLIC_ prefix.
TMDB_API_KEY=

# Google Books API key (console.cloud.google.com, enable "Books API").
# Optional but recommended: without it, requests share Google's low
# unauthenticated daily quota. Server-only, no NEXT_PUBLIC_ prefix.
GOOGLE_BOOKS_API_KEY=

# Set to "true" to serve fixture search results from src/lib/catalog/mock-data.ts
# instead of calling Google Books/TMDB. Speeds up local dev and avoids quotas.
# Leave unset (or any other value) to use the real APIs.
MOCK_EXTERNAL_APIS=
