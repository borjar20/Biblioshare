<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout del selector de widgets (API 31+) para "Registro rápido"
     (Reducido). Estático: imita el paso 1 (lista de obras en curso) con Paper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    tools:ignore="HardcodedText,ContentDescription,SpUsage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Registrar lectura"
            android:textColor="@color/widget_fg"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 en curso"
            android:textColor="@color/widget_fg_soft"
            android:textSize="11sp" />
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="54dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_placeholder" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Libro"
                android:textColor="@color/widget_fg_soft"
                android:textSize="11sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="El Ojo del Mundo"
                android:textColor="@color/widget_fg"
                android:textSize="13sp"
                android:textStyle="bold" />
            <Space android:layout_width="1dp" android:layout_height="4dp" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="35"
                android:progressTint="@color/widget_accent"
                android:progressBackgroundTint="@color/widget_track" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="54dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_placeholder" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Libro"
                android:textColor="@color/widget_fg_soft"
                android:textSize="11sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Siega"
                android:textColor="@color/widget_fg"
                android:textSize="13sp"
                android:textStyle="bold" />
            <Space android:layout_width="1dp" android:layout_height="4dp" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="10"
                android:progressTint="@color/widget_accent"
                android:progressBackgroundTint="@color/widget_track" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
