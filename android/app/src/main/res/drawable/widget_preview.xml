<?xml version="1.0" encoding="utf-8"?>
<!-- Respaldo `previewImage` para el selector de widgets en API < 31 (donde no se
     usa previewLayout). Tarjeta Paper con franja de acento, portada y líneas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="110dp" android:height="72dp"
    android:viewportWidth="110" android:viewportHeight="72">
    <!-- Fondo base -->
    <path android:fillColor="@color/widget_bg"
        android:pathData="M0,0 h110 v72 h-110 z" />
    <!-- Tarjeta de foco (surface) -->
    <path android:fillColor="@color/widget_surface"
        android:pathData="M6,6 h98 a6,6 0 0 1 6,6 v48 a6,6 0 0 1 -6,6 h-98 a6,6 0 0 1 -6,-6 v-48 a6,6 0 0 1 6,-6 z" />
    <!-- Franja de acento a la izquierda -->
    <path android:fillColor="@color/widget_accent"
        android:pathData="M0,6 h4 v60 h-4 a2,2 0 0 1 -2,-2 v-56 a2,2 0 0 1 2,-2 z" />
    <!-- Portada -->
    <path android:fillColor="@color/widget_track"
        android:pathData="M14,16 h20 v40 h-20 z" />
    <!-- Líneas de texto -->
    <path android:fillColor="@color/widget_accent"
        android:pathData="M42,18 h26 v4 h-26 z" />
    <path android:fillColor="@color/widget_fg"
        android:pathData="M42,28 h50 v6 h-50 z" />
    <path android:fillColor="@color/widget_fg_soft"
        android:pathData="M42,40 h38 v4 h-38 z" />
    <!-- Barra de progreso -->
    <path android:fillColor="@color/widget_track"
        android:pathData="M42,50 h50 v4 h-50 z" />
    <path android:fillColor="@color/widget_accent"
        android:pathData="M42,50 h28 v4 h-28 z" />
</vector>
